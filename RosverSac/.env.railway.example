# Variables para el servicio web en Railway (Variables → Shared / Service).
# NO pegar secretos de R2 en variables VITE_* (se exponen al navegador).
#
# Fase visual (SPA): la web no necesita R2 ni Postgres en runtime del browser.
# Postgres y R2 keys van al backend futuro (otro servicio), no al front.

# --- Auto Railway ---
# PORT=                (lo define Railway)
# DATABASE_URL=        (lo inyecta el plugin Postgres si lo vinculas)

# --- Opcional metadata (seguras de exponer) ---
# VITE_R2_PUBLIC_BASE_URL=https://pub-xxxxx.r2.dev
# VITE_APP_VERSION=0.1.0
