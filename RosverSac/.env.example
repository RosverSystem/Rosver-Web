# Variables de entorno — copiar a `.env` en la raíz del monorepo (gitignored).
# Nunca commitear valores reales.

# VITE_* se exponen al cliente en build time
# VITE_API_URL=
# VITE_R2_PUBLIC_BASE_URL=
# VITE_APP_VERSION=0.1.0

# Railway CLI — https://railway.app/account/tokens (Account Token, no UUID de proyecto)
# RAILWAY_TOKEN=

# Postgres (Railway) — nunca en VITE_*
# DATABASE_URL=                 # interno: Postgres.railway.internal
# DATABASE_PUBLIC_URL=          # TCP proxy (solo local/admin)
# POSTGRES_USER=
# POSTGRES_PASSWORD=
# POSTGRES_DB=
# POSTGRES_HOST_PUBLIC=
# POSTGRES_PORT_PUBLIC=

# Cloudflare
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_R2_ACCOUNT_TOKEN=

# R2
# R2_BUCKET_PUBLIC=rosver-public-media
# R2_BUCKET_PRIVATE=rosver-private-docs
# R2_BUCKET_LEGACY=rosverimg
# R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_PUBLIC_BASE_URL=   # opcional (r2.dev / CDN); si vacío → /api/media/…
