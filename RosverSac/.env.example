# Variables de entorno — copiar a `.env` en la raíz del monorepo (gitignored).
# Nunca commitear valores reales.

# VITE_* se exponen al cliente en build time
# VITE_API_URL=
# VITE_R2_PUBLIC_BASE_URL=
# VITE_APP_VERSION=0.1.0

# App pública / CORS (server)
# ──────────────────────────────────────────────────────────────────────────────
# Local (desarrollo diario):
# APP_URL=http://localhost:5173
# CORS_ORIGIN=http://localhost:5173

# Producción — dominio canónico rosversac.com (tras cutover DNS/CDN en §4):
# APP_URL=https://rosversac.com
# CORS_ORIGIN=https://rosversac.com
# CORS_ORIGINS=https://rosversac.com,https://www.rosversac.com
#   (CORS_ORIGINS: lista separada por comas; si APP_URL es rosversac.com, www se incluye automático)

# Producción — hasta el cutover, Railway puede seguir con:
# APP_URL=https://rosver-web-production.up.railway.app
# CORS_ORIGIN=https://rosver-web-production.up.railway.app

# Cookie de sesión — dominio compartido entre apex y www (solo si se usan subdominios):
# COOKIE_DOMAIN=.rosversac.com

# Railway CLI — https://railway.app/account/tokens
# Crear token con Scope = Account (Workspace: No workspace).
# CLI v5.50+: usar RAILWAY_API_TOKEN (no RAILWAY_TOKEN con UUID → Invalid).
# RAILWAY_API_TOKEN=
# RAILWAY_TOKEN=

# Postgres — nunca en VITE_*
# Local (recomendado para desarrollo):
# DATABASE_URL=postgresql://rosver:TU_PASSWORD@localhost:5432/rosver_local
# Luego: npm run db:setup
#
# Híbrido local: Postgres local + Redis Railway (TCP proxy) + R2 Cloudflare
# REDIS_URL=redis://:PASSWORD@HOST_PROXY:PORT
# REDISHOST=
# REDISPORT=
# REDISPASSWORD=
# R2_ENDPOINT=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_PUBLIC=rosver-public-media
#
# Railway (prod / proxy admin):
# DATABASE_URL=                 # interno: Postgres.railway.internal
# DATABASE_PUBLIC_URL=          # TCP proxy (solo local/admin)
# POSTGRES_USER=
# POSTGRES_PASSWORD=
# POSTGRES_DB=
# POSTGRES_HOST_PUBLIC=
# POSTGRES_PORT_PUBLIC=

# Redis (Railway) — caché Destacados home; opcional (sin él → solo Postgres)
# REDIS_URL=                    # interno redis://default:…@redis.railway.internal:6379
# REDIS_PRIVATE_URL=            # alias Railway

# Cloudflare
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_R2_ACCOUNT_TOKEN=

# R2
# R2_BUCKET_PUBLIC=rosver-public-media
# R2_BUCKET_PRIVATE=rosver-private-docs
# R2_BUCKET_LEGACY=rosverimg
# R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_PUBLIC_BASE_URL=   # opcional (r2.dev / CDN); si vacío → /api/media/…

# Auth seed (defaults en server/src/config.ts — override en Railway / .env local)
# SEED_ADMIN_EMAIL=admin@multiserviciosmta.site
# SEED_ADMIN_PASSWORD=RosverAdmin!2026
# SEED_CLIENT_EMAIL=acosta.wp076@gmail.com
# SEED_CLIENT_PASSWORD=RosverCliente!2026

# SMTP (OTP / correo) — Hostinger: preferir 587 STARTTLS (465 a menudo ETIMEDOUT)
# SMTP_HOST=smtp.hostinger.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=Rosver SAC <noreply@rosversac.com>
#
# Brand en R2: npx tsx server/scripts/upload-brand-assets.ts
# Opcional CDN directo (si no, /api/media/brand/…):
# R2_PUBLIC_BASE_URL=https://pub-xxxxx.r2.dev

# Decolecta — consulta RUC (SUNAT) / DNI (RENIEC). Solo server, nunca VITE_*.
# DECOLECTA_API_KEY=

# Geoapify — autocomplete dirección (free ~3000 créd/día). Si límite → Nominatim.
# GEOAPIFY_API_KEY=

# Google Maps / Places — autocomplete de dirección (calidad Maps en /cotizar).
# 1) Google Cloud → APIs: Maps JavaScript API + Places API
# 2) Clave restringida por HTTP referrer (localhost:5173 + https://rosversac.com)
# VITE_GOOGLE_MAPS_API_KEY=   # front (Places Autocomplete en el navegador)
# GOOGLE_MAPS_API_KEY=        # opcional server (mismo key o otra restringida por IP)
# GOOGLE_PLACES_API_KEY=      # alias opcional server

# Google OAuth 2.0 — "Continuar con Google" en login/registro.
# 1) Google Cloud Console → APIs → Credentials → OAuth 2.0 Client ID (tipo Web)
# 2) Authorized redirect URIs: http://localhost:8787/api/auth/google/callback (dev)
#    y https://rosver-web-production.up.railway.app/api/auth/google/callback (prod)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:8787/api/auth/google/callback

# Railway metadata — disponibles automáticamente en el entorno Railway
# Útiles para trazabilidad de deploys y health checks
# RAILWAY_SERVICE_ID=
# RAILWAY_ENVIRONMENT_ID=
# RAILWAY_GIT_COMMIT_SHA=   # SHA del commit desplegado → expuesto en /api/health
# GIT_COMMIT=               # alias alternativo si no está en Railway
